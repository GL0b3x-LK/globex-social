# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# --- OpenAI (Whisper transcription of WhatsApp voice notes only) ---
# Optional: leave blank to disable voice notes; everything else still works.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Twilio (WhatsApp) ---
# Dev uses the shared Sandbox sender (+14155238886). Production sender set at launch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Comma-separated allowlist of senders allowed to drive the bot.
# Karen's number is added at handover; dev/test numbers can be included.
AUTHORIZED_NUMBERS=whatsapp:+19178592787

# --- Blotato (publishing) ---
BLOTATO_API_KEY=

# --- Supabase (REST API — used by all runtime db helpers) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=post-images

# --- Supabase Postgres (DDL only — scripts/apply_schema.py) ---
# Dashboard -> Settings -> Database -> Connection string -> URI (Session pooler).
SUPABASE_DB_URL=

# --- App ---
ENVIRONMENT=development
TIMEZONE=America/New_York
LOG_LEVEL=INFO
